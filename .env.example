NODE_ENV=development
PORT=4000
# Neon: use the DEV branch connection string while developing (pooled host, sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Only needed if the frontend calls the API directly (not through the Vite/Vercel proxy)
CORS_ORIGIN=
# Required on the backend deployment (Render), not Vercel, for request photos,
# videos, and repair-plan inspection media. Redeploy the backend after changing these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Used only by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_PHONE=+2348000000000
